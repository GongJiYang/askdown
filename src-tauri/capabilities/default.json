{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的权限：选择文件夹，以及向模型服务发起 HTTP 请求",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*/*" },
        { "url": "http://localhost:*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
